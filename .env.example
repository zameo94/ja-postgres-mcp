# PostgreSQL connection
JA_POSTGRES_DB_HOST=localhost
JA_POSTGRES_DB_PORT=5432
JA_POSTGRES_DB_NAME=ja_postgres
JA_POSTGRES_DB_USER=ja_postgres
JA_POSTGRES_DB_PASSWORD=change-me

# Connection pool (bounds concurrent DB work)
JA_POSTGRES_DB_POOL_MIN=1
JA_POSTGRES_DB_POOL_MAX=5
JA_POSTGRES_DB_POOL_TIMEOUT=30

# MCP server (Streamable HTTP)
JA_POSTGRES_SERVER_HOST=0.0.0.0
JA_POSTGRES_SERVER_PORT=8000
# Required when SERVER_HOST is not localhost. Setting it enables DNS-rebinding
# protection (Host/Origin validation).
JA_POSTGRES_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000,ja-postgres-mcp:8000
# Required only by browser-based MCP clients (they always send an Origin).
# A server-to-server MCP client may leave this empty.
JA_POSTGRES_ALLOWED_ORIGINS=

# Read-only analysis query policy
JA_POSTGRES_MAX_ROWS=200
JA_POSTGRES_STATEMENT_TIMEOUT=5
JA_POSTGRES_LOCK_TIMEOUT=5
# Discovery pagination (keyset); next_cursor drives page traversal.
JA_POSTGRES_DISCOVERY_PAGE_SIZE=200
JA_POSTGRES_DISCOVERY_MAX_PAGE_SIZE=1000
# Consumed by the discovery tools (schema/table listing), not by arbitrary
# read-only queries. Empty = all non-system schemas.
JA_POSTGRES_ALLOWED_SCHEMAS=

# Optional
JA_POSTGRES_DB_CONNECT_TIMEOUT=10
JA_POSTGRES_LOG_LEVEL=INFO
